rules_version = '2';

// Reglas de seguridad de la base de datos (Firestore) del multijugador.
// Se suben con: firebase deploy --only firestore:rules (desde esta carpeta)
service cloud.firestore {
  match /databases/{database}/documents {

    function conectado() {
      return request.auth != null;
    }

    function idAmistad(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Perfil público: solo el nombre de usuario. Cada uno edita solo el suyo.
    match /usuarios/{uid} {
      allow read: if conectado();
      allow create, update: if conectado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'nombreMin', 'creado', 'visto', 'actividad', 'foto'])
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string
            && request.resource.data.foto.size() < 90000
            && request.resource.data.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && (!('visto' in request.resource.data) || request.resource.data.visto == request.time
            || request.resource.data.visto == resource.data.visto)
        && (!('actividad' in request.resource.data) || (request.resource.data.actividad is string && request.resource.data.actividad.size() <= 40))
        && request.resource.data.nombre is string
        && request.resource.data.nombreMin == request.resource.data.nombre.lower()
        && getAfter(/databases/$(database)/documents/nombres/$(request.resource.data.nombreMin)).data.uid == uid;
      allow delete: if false;
    }

    // Reserva de nombres de usuario (el id del documento es el nombre en minúsculas): no se repiten.
    match /nombres/{nombre} {
      allow read: if conectado();
      allow create: if conectado()
        && nombre.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombreMin == nombre;
      allow delete: if conectado() && resource.data.uid == request.auth.uid;
    }

    // Amistades: se crean pendientes y solo el invitado puede aceptarlas.
    match /amistades/{id} {
      allow read: if conectado() && request.auth.uid in resource.data.uids;
      allow create: if conectado()
        && request.resource.data.keys().hasOnly(['uids', 'de', 'para', 'nombres', 'estado', 'creada'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para != request.auth.uid
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids.hasAll([request.resource.data.de, request.resource.data.para])
        && request.resource.data.estado == 'pendiente'
        && id == idAmistad(request.resource.data.de, request.resource.data.para);
      allow update: if conectado()
        && resource.data.para == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'aceptada';
      allow delete: if conectado() && request.auth.uid in resource.data.uids;
    }

    function sonAmigos(a, b) {
      return get(/databases/$(database)/documents/amistades/$(idAmistad(a, b))).data.estado == 'aceptada';
    }

    // Mensaje de chat. tipo: texto, sticker, partida (un juego mandado por el chat) o regalo (fichas).
    // Un regalo o una partida en el chat tienen que existir de verdad y ser de quien manda el mensaje.
    function mensajeValido() {
      let d = request.resource.data;
      let tipo = d.get('tipo', 'texto');
      return d.keys().hasOnly(['de', 'texto', 'creado', 'tipo', 'sticker', 'partida', 'juego', 'apuesta', 'regalo', 'cantidad', 'responde'])
        && (!('responde' in d) || (d.responde is map && d.responde.keys().hasOnly(['id', 'de', 'texto'])
            && d.responde.texto is string && d.responde.texto.size() <= 120))
        && d.de == request.auth.uid
        && d.texto is string
        && d.texto.size() > 0
        && d.texto.size() <= 300
        && d.creado == request.time
        && tipo in ['texto', 'sticker', 'partida', 'regalo']
        && (tipo != 'sticker' || (d.sticker is string && d.sticker.size() <= 20))
        && (tipo != 'regalo' || (getAfter(/databases/$(database)/documents/regalos/$(d.regalo)).data.de == request.auth.uid
            && getAfter(/databases/$(database)/documents/regalos/$(d.regalo)).data.cantidad == d.cantidad))
        && (tipo != 'partida' || getAfter(/databases/$(database)/documents/partidas/$(d.partida)).data.creador == request.auth.uid);
    }

    function fichasDe(uid) {
      return get(/databases/$(database)/documents/billeteras/$(uid)).data.fichas;
    }

    function fichasDespues(uid) {
      return getAfter(/databases/$(database)/documents/billeteras/$(uid)).data.fichas;
    }

    // Partidas entre dos amigos. Solo ellos dos pueden verlas y jugarlas.
    // apuesta: fichas que pone cada uno (hasta 10 millones); no se puede cambiar después de crearla.
    match /partidas/{id} {
      allow read: if conectado() && request.auth.uid in resource.data.jugadores;
      allow create: if conectado()
        && request.resource.data.creador == request.auth.uid
        && request.resource.data.jugadores.size() == 2
        && request.auth.uid in request.resource.data.jugadores
        && request.resource.data.estado == 'invitada'
        && (!('apuesta' in request.resource.data) || (request.resource.data.apuesta is int
            && request.resource.data.apuesta >= 0 && request.resource.data.apuesta <= 10000000))
        && sonAmigos(request.resource.data.jugadores[0], request.resource.data.jugadores[1]);
      allow update: if conectado()
        && request.auth.uid in resource.data.jugadores
        && request.resource.data.jugadores == resource.data.jugadores
        && request.resource.data.creador == resource.data.creador
        && request.resource.data.get('apuesta', 0) == resource.data.get('apuesta', 0);
      allow delete: if conectado() && request.auth.uid in resource.data.jugadores;

      // Chat de la partida
      match /mensajes/{m} {
        allow read: if conectado() && request.auth.uid in get(/databases/$(database)/documents/partidas/$(id)).data.jugadores;
        allow create: if conectado() && mensajeValido()
          && request.auth.uid in get(/databases/$(database)/documents/partidas/$(id)).data.jugadores;
        allow update: if conectado() && soloMiReaccion()
          && request.auth.uid in get(/databases/$(database)/documents/partidas/$(id)).data.jugadores;
        allow delete: if conectado() && resource.data.de == request.auth.uid;
      }
    }

    // Reaccionar a un mensaje: solo se toca la reacción propia
    function soloMiReaccion() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones'])
        && request.resource.data.reacciones is map
        && request.resource.data.reacciones.diff(resource.data.get('reacciones', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.reacciones)
            || (request.resource.data.reacciones[request.auth.uid] is string && request.resource.data.reacciones[request.auth.uid].size() <= 8));
    }

    function enElChat(chat) {
      return request.auth.uid in get(/databases/$(database)/documents/amistades/$(chat)).data.uids
        && get(/databases/$(database)/documents/amistades/$(chat)).data.estado == 'aceptada';
    }

    // Chat entre dos amigos (el id es el mismo que el de la amistad).
    // El documento del chat guarda hasta cuándo leyó cada uno (visto) y quién está escribiendo.
    match /chats/{chat} {
      allow read: if conectado() && enElChat(chat);
      allow create, update: if conectado() && enElChat(chat)
        && request.resource.data.keys().hasOnly(['leido', 'escribiendo']);
    }

    match /chats/{chat}/mensajes/{m} {
      allow read: if conectado() && enElChat(chat);
      allow create: if conectado() && mensajeValido() && enElChat(chat);
      allow update: if conectado() && soloMiReaccion() && enElChat(chat);
      allow delete: if conectado() && resource.data.de == request.auth.uid;
    }

    // Billetera de fichas del casino, estadísticas y experiencia. Todos la ven (ranking), cada uno edita la suya.
    match /billeteras/{uid} {
      allow read: if conectado();
      allow create, update: if conectado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fichas', 'recarga', 'actualizada', 'stats', 'xp'])
        && request.resource.data.fichas is number
        && request.resource.data.fichas >= 0;
      allow delete: if false;
    }

    // Progreso guardado de cada juego (copia en la nube del almacenamiento del dispositivo). Solo lo ve y edita su dueño.
    match /progreso/{uid}/claves/{clave} {
      allow read, delete: if conectado() && request.auth.uid == uid;
      allow create, update: if conectado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['valor', 'tsLocal', 'ts'])
        && request.resource.data.valor is string
        && request.resource.data.valor.size() < 500000
        && request.resource.data.tsLocal is number;
    }

    // Regalos de fichas entre amigos. Quien regala paga en el mismo lote; quien recibe cobra una sola vez.
    match /regalos/{id} {
      allow read: if conectado() && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if conectado()
        && request.resource.data.keys().hasOnly(['de', 'para', 'nombreDe', 'cantidad', 'cobrado', 'creado'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para != request.auth.uid
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad > 0
        && request.resource.data.cantidad <= 10000000
        && request.resource.data.cobrado == false
        && sonAmigos(request.auth.uid, request.resource.data.para)
        && fichasDespues(request.auth.uid) == fichasDe(request.auth.uid) - request.resource.data.cantidad;
      allow update: if conectado()
        && resource.data.para == request.auth.uid
        && resource.data.cobrado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobrado'])
        && request.resource.data.cobrado == true
        && fichasDespues(request.auth.uid) == fichasDe(request.auth.uid) + resource.data.cantidad;
      allow delete: if false;
    }
  }
}
